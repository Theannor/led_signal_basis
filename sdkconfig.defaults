CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# mDNS ohne Konsolen-Befehle (bräuchte die Komponente console)
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
# Größere App-Partition (1500 KB statt 1 MB); NVS bleibt unverändert
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# Bluetooth LE (NimBLE) zum Setzen der Farben; nur Peripheral, eine Verbindung
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
